msgid "Launch amlogic-multistream (stops Kodi, no picture until DRM)"
msgstr ""

msgctxt "#30002"
msgid "Settings"
msgstr ""

msgctxt "#30010"
msgid "Could not start the player. Kodi was not stopped."
msgstr ""

msgctxt "#30011"
msgid "Stopping Kodi. Software mode shows nothing until DRM/KMS. Kodi returns when the player exits."
msgstr ""

msgctxt "#30100"
msgid "Player"
msgstr ""

msgctxt "#30101"
msgid "Player binary or AppImage"
msgstr ""

msgctxt "#30102"
msgid "PLAYER_BIN for the launch script. Use the device AppImage for this box's CoreELEC line: coreelec21-ng-armv7hf on CoreELEC 21 Amlogic-ng, coreelec22-no-aarch64 on CoreELEC 22 Amlogic-no. The x86_64 and Ubuntu aarch64 CI AppImages are host smoke builds and do not run here."
msgstr ""

msgctxt "#30103"
msgid "Launch script override"
msgstr ""

msgctxt "#30104"
msgid "Leave empty to use the launch-coreelec.sh bundled with this add-on."
msgstr ""

msgctxt "#30200"
msgid "MQTT"
msgstr ""

msgctxt "#30201"
msgid "Broker host"
msgstr ""

msgctxt "#30202"
msgid "MQTT_HOST. Empty leaves the player default (localhost)."
msgstr ""

msgctxt "#30203"
msgid "Broker port"
msgstr ""

msgctxt "#30204"
msgid "MQTT_PORT. 0 leaves the player default (1883)."
msgstr ""

msgctxt "#30205"
msgid "Topic prefix"
msgstr ""

msgctxt "#30206"
msgid "MQTT_TOPIC_PREFIX. Empty leaves the player default (amlogic-multistream)."
msgstr ""

msgctxt "#30207"
msgid "Broker username"
msgstr ""

msgctxt "#30208"
msgid "MQTT_USERNAME. Empty connects anonymously. Home Assistant Mosquitto refuses anonymous clients."
msgstr ""

msgctxt "#30209"
msgid "Broker password"
msgstr ""

msgctxt "#30210"
msgid "MQTT_PASSWORD. Empty sends no password. When set, Launch writes it to mqtt.env (mode 0600) in this add-on's profile and passes that file as EnvironmentFile=, so systemctl show does not list the password."
msgstr ""
